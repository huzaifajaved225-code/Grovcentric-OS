# Root Next.js app that hosts the AI agents. Run it on port 3000.
AI_SERVICE_URL=http://127.0.0.1:3000

# Use the same random, 32+ character token in the root app's .env as AI_SERVICE_TOKEN.
# Never expose this token to the browser or commit a real token.
AI_SERVICE_TOKEN=replace-with-a-random-secret-at-least-32-characters
